# Cardputer (original + ADV), M5Stamp-S3: ESP32-S3FN8 — 8 MB flash
# (QIO/80MHz), 512 KB SRAM, no PSRAM.
#
# QIO matters: textures, sprites and map data are read straight from the
# MMU-mapped "wad" partition on every frame.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT=y

# Doom runs in app_main; BSP traversal and the menu code are recursive.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

CONFIG_FREERTOS_HZ=1000

# The game loop owns CPU0 and the audio mixer owns CPU1, so idle tasks starve.
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=n
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n

# Savegames on the SD card: 8.3 names are enough (DOOM0.DSG .. DOOM7.DSG).
CONFIG_FATFS_LFN_NONE=y
