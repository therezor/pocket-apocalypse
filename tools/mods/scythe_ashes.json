  "end_flat": "SLIME16",
  "end_text": [
    "THE LORDS OF THE WASTE ARE DUST.",
    "",
    "YOU STAND ON THE RUBBLE WITH",
    "POCKETS FULL OF BOTTLE CAPS.",
    "THE APOCALYPSE IS OVER, AND IT",
    "FITS IN ONE HAND.",
    "",
    "NOW GO CHARGE YOUR CARDPUTER."
  ],
  "strings": {
    "GOTSHOTGUN": "Got the Lever Action Shotgun!",
    "GOTSHOTGUN2": "Got the Hunter Shotgun!",
    "GOTCHAINGUN": "Got the Modular Rifle!",
    "GOTLAUNCHER": "Got the Thumper!",
    "GOTPLASMA": "Got the Bolt-Caster!",
    "HUSTR_1": "1: Get going!",
    "HUSTR_2": "2: Punchline",
    "HUSTR_3": "3: Up and around",
    "HUSTR_4": "4: Lost warehouse",
    "HUSTR_5": "5: Slimy tunnels",
    "HUSTR_6": "6: Pressure point",
    "HUSTR_7": "7: Deadly",
    "HUSTR_8": "8: Garden base",
    "HUSTR_9": "9: Computer storage",
    "HUSTR_10": "10: The Lords",
    "PRESSYN": "press Enter.",
    "NIGHTMARE": "Glow In The Dark? Mutants come\nback, raiders shoot faster and\nnobody brought sunscreen.\n\npress Enter if you glow.",
    "PD_BLUEO": "Need the blue key for this",
    "PD_REDO": "Need the red key for this",
    "PD_YELLOWO": "Need the yellow key for this",
    "C1TEXT": "HALFWAY THROUGH THE ZONE.\n\nYOUR BOOTS ARE MELTING, YOUR\nCANTEEN TASTES LIKE BATTERIES\nAND THE RAIDERS HAVE STARTED\nWRITING SONGS ABOUT YOU.\n\nTERRIBLE SONGS.\n\nRELOAD, WANDERER. THE LORDS\nOF THE WASTE ARE WAITING."
  },
